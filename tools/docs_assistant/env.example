# Required MCP endpoint. Keep the real endpoint outside Git.
export DOCS_ASSISTANT_MCP_URL="https://mcp.example.com/mcp"
export DOCS_ASSISTANT_MCP_COLLECTIONS="md_knowledge_2560,pdf_ocr_knowledge_2560"

# Optional MCP authentication.
export DOCS_ASSISTANT_MCP_AUTH_HEADER="Authorization"
export DOCS_ASSISTANT_MCP_AUTH_VALUE="Bearer replace-me"

# Optional OpenAI-compatible chat completion endpoint.
export DOCS_ASSISTANT_LLM_URL="https://llm.example.com/v1/chat/completions"
export DOCS_ASSISTANT_LLM_MODEL="replace-me"
export DOCS_ASSISTANT_LLM_API_KEY="replace-me"

export DOCS_ASSISTANT_ALLOWED_ORIGINS="http://127.0.0.1:8200,http://localhost:8200"
